# Reference only: the compose wrapper uses the official RAGFlow .env in
# D:\RAGFlow\ragflow\docker. Do not copy real secrets into this repository.
# Never commit real passwords or API keys.

# Values consumed by docker-compose.override.yml
DB_TYPE=mysql
DOC_ENGINE=elasticsearch
DEVICE=cpu
METADATA_DB_PROFILE=mysql
COMPOSE_PROFILES=elasticsearch,cpu,metadata-mysql
ES_HOST=es01
ELASTIC_PASSWORD=change-me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DBNAME=rag_flow
MINIO_HOST=minio
MINIO_USER=rag_flow
MINIO_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
RAGFLOW_HOST=ragflow-cpu
SVR_HTTP_PORT=9380
TZ=Asia/Shanghai

# The official .env controls the image and published ports. Keep the local
# override bound to 127.0.0.1:8081 through docker-compose.override.yml.
